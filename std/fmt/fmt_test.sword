package fmt

import "std/bytes"
import "std/testing"

func shown(mut t *testing.T, v f64) !string {
    mut b := try bytes.New(t.Mem, 64)
    try Float(&b, v)
    return b.Str()
}

func fixed(mut t *testing.T, v f64, decimals u64) !string {
    mut b := try bytes.New(t.Mem, 64)
    try F64(&b, v, decimals)
    return b.Str()
}

func TestFloatOrdinary(mut t *testing.T) !void {
    try t.Equal(try shown(t, 0.0), "0.0")
    try t.Equal(try shown(t, 3.25), "3.25")
    try t.Equal(try shown(t, -3.25), "-3.25")
    try t.Equal(try shown(t, 123456789.5), "123456789.5")
    try t.Equal(try fixed(t, 3.14159, 2), "3.14")
    try t.Equal(try fixed(t, 2.0, 0), "2")
}

// `{}` keeps fourteen digits in front of the point at most, and past that
// gives a mantissa and a power of ten, with the mantissa's digits exact.
func TestFloatLargeInExponentForm(mut t *testing.T) !void {
    try t.Equal(try shown(t, 1.0e12), "1000000000000.0")
    try t.Equal(try shown(t, 1.0e13), "10000000000000.0")
    try t.Equal(try shown(t, 1.0e16), "1.000000e+16")
    try t.Equal(try shown(t, 1.0e19), "1.000000e+19")
    try t.Equal(try shown(t, 1.0e22), "1.000000e+22")
    try t.Equal(try shown(t, -2.5e20), "-2.500000e+20")
    // 1e23 is not a double; the nearest one is 99999999999999991611392.
    try t.Equal(try shown(t, 1.0e23), "1.000000e+23")
    try t.Equal(try shown(t, 9.9999995e20), "9.999999e+20")
    try t.Equal(try shown(t, 9.99999951e20), "1.000000e+21")
}

func big(mut t *testing.T, v f64, decimals u64) !string {
    mut b := try bytes.New(t.Mem, 2048)
    try F64(&b, v, decimals)
    return b.Str()
}

// The digits are the double's own, as far as they are asked for: a double is
// m·2^e, its expansion ends, and C's printf gives the same. Two doubles one
// unit apart print differently.
func TestFixedIsExact(mut t *testing.T) !void {
    try t.Equal(try fixed(t, 0.1, 20), "0.10000000000000000555")
    try t.Equal(try fixed(t, 0.74675300453429376, 17), "0.74675300453429372")
    try t.Equal(try fixed(t, 0.74675300453429387, 17), "0.74675300453429383")
    try t.Equal(try fixed(t, 1.0e19, 2), "10000000000000000000.00")
    try t.Equal(try fixed(t, 3.14159, 2), "3.14")

    huge := try big(t, 1.0e300, 0)
    try t.Equal(huge.len, u64(301))
    try t.Equal(huge[0..40], "1000000000000000052504760255204420248704")

    tiny := try big(t, 4.9406564584124654e-324, 1074)
    try t.Equal(tiny[0..6], "0.0000")
    try t.Equal(tiny[tiny.len - 29..tiny.len], "38682506419718265533447265625")
}

// Rounded once, to nearest, a tie going to the even digit: the only rounding
// with no drift in one direction, and what printf does.
func TestFixedRoundsHalfToEven(mut t *testing.T) !void {
    try t.Equal(try fixed(t, 0.125, 2), "0.12")
    try t.Equal(try fixed(t, 0.375, 2), "0.38")
    try t.Equal(try fixed(t, 2.5, 0), "2")
    try t.Equal(try fixed(t, 3.5, 0), "4")
    try t.Equal(try fixed(t, 8.5, 0), "8")
    try t.Equal(try fixed(t, 999.96, 1), "1000.0")
    try t.Equal(try fixed(t, -0.5, 0), "-0")
}

// Negative zero is a double of its own, and prints as one.
func TestNegativeZero(mut t *testing.T) !void {
    zero := 0.0
    negative := -zero
    try t.Equal(try fixed(t, negative, 2), "-0.00")
    try t.Equal(try shown(t, negative), "-0.0")
    try t.Equal(try shown(t, zero), "0.0")
}

// A NaN is not equal to anything, itself included, which is how one is
// recognised without reaching for its bits — and an infinity is above every
// number there is.
func TestFloatNotNumbers(mut t *testing.T) !void {
    big := 1.0e308
    inf := big * 10.0
    zero := big - big
    nan := zero / zero

    try t.Equal(nan != nan, true)
    try t.Equal(nan == nan, false)
    try t.Equal(nan < 1.0, false)
    try t.Equal(nan > 1.0, false)

    try t.Equal(try shown(t, nan), "nan")
    try t.Equal(try shown(t, inf), "inf")
    try t.Equal(try shown(t, -inf), "-inf")
    try t.Equal(try fixed(t, nan, 3), "nan")
    try t.Equal(try fixed(t, inf, 3), "inf")
}
