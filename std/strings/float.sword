package strings

// Decimal text to the double nearest it.
//
// Nearest, not near: the answer is the one double closest to the exact value the
// text writes, a tie going to the even one — so a double printed with enough
// digits reads back as itself, and the same text gives the same bits on every
// machine. Adding digits up in doubles gets most inputs right and some wrong
// (0.3 came out one unit high that way); this does not guess.
//
// Most text is a short number: up to fifteen digits and a power of ten up to 22,
// where both are exact doubles and one multiplication or division rounds once
// (Clinger's fast path). The rest is exact integer arithmetic on the digits, in
// 32-bit pieces held in fixed arrays on the stack, since parsing takes no
// allocator.

// Past this many significant digits the rest only decide rounding, and whether
// any of them is not zero is all that is kept of them. 767 is the most any
// halfway point between two doubles needs.
const keptDigits = 800

const limbs = 240

struct big {
    w    [240]u64 // 32 bits in each, least significant first
    used u64
}

func newBig(v u64) big {
    mut b := big{w: [240]u64{}, used: 0}
    b.w[0] = v & 0xFFFFFFFF
    b.w[1] = v >> 32
    b.used = 2
    b.trim()
    return b
}

func (mut b *big) trim() {
    for b.used > 0 && b.w[b.used - 1] == 0 {
        b.used -= 1
    }
}

// b·m + add, for m and add below 2^32.
func (mut b *big) mulAdd(m u64, add u64) {
    mut carry := add
    for i in 0..b.used {
        cur := b.w[i] * m + carry
        b.w[i] = cur & 0xFFFFFFFF
        carry = cur >> 32
    }
    if carry != 0 {
        b.w[b.used] = carry
        b.used += 1
    }
}

func (b *big) bitLen() u64 {
    if b.used == 0 {
        return 0
    }
    mut top := b.w[b.used - 1]
    mut n u64 = 0
    for top != 0 {
        top >>= 1
        n += 1
    }
    return (b.used - 1) * 32 + n
}

func (mut b *big) shiftLeft(bits u64) {
    if b.used == 0 || bits == 0 {
        return
    }
    words := bits / 32
    sh := bits % 32
    mut i := b.used
    b.w[b.used + words] = 0
    for i > 0 {
        i -= 1
        v := b.w[i] << sh
        b.w[i + words + 1] |= v >> 32
        b.w[i + words] = v & 0xFFFFFFFF
    }
    for j in 0..words {
        b.w[j] = 0
    }
    b.used += words + 1
    b.trim()
}

// -1, 0 or 1 as a is below, equal to or above b.
func compare(a *big, b *big) i64 {
    if a.used != b.used {
        if a.used < b.used {
            return -1
        }
        return 1
    }
    mut i := a.used
    for i > 0 {
        i -= 1
        if a.w[i] != b.w[i] {
            if a.w[i] < b.w[i] {
                return -1
            }
            return 1
        }
    }
    return 0
}

// a - b, for a at least b.
func (mut a *big) subtract(b *big) {
    mut borrow u64 = 0
    for i in 0..a.used {
        mut sub := borrow
        if i < b.used {
            sub += b.w[i]
        }
        if a.w[i] >= sub {
            a.w[i] -= sub
            borrow = 0
        } else {
            a.w[i] = a.w[i] + 0x100000000 - sub
            borrow = 1
        }
    }
    a.trim()
}

func fromBits(b u64) f64 {
    mut x := b
    p := [*]f64(&x)
    return p[0]
}

// The double nearest q·2^p, where `beyond` says the exact value is a little
// more than that. q has at least 55 bits, so the rounding bit and everything
// below it are in it.
func nearest(q u64, p i64, beyond bool, negative bool) f64 {
    mut n u64 = 0
    mut v := q
    for v != 0 {
        v >>= 1
        n += 1
    }
    mut sign u64 = 0
    if negative {
        sign = 1 << 63
    }
    top := i64(n) - 1 + p
    if top > 1023 {
        return fromBits(sign | 0x7FF0000000000000)
    }
    mut lsb := top - 52
    if lsb < -1074 {
        lsb = -1074
    }
    drop := lsb - p
    if drop > 64 {
        return fromBits(sign)
    }
    mut mant u64 = 0
    mut half := false
    mut rest := beyond
    if drop == 64 {
        half = q >> 63 == 1
        rest = rest || q & 0x7FFFFFFFFFFFFFFF != 0
    } else {
        mant = q >> u64(drop)
        half = (q >> u64(drop - 1)) & 1 == 1
        rest = rest || q & ((u64(1) << u64(drop - 1)) - 1) != 0
    }
    if half && (rest || mant & 1 == 1) {
        mant += 1
        if mant == u64(1) << 53 {
            mant >>= 1
            lsb += 1
        }
    }
    if mant >= u64(1) << 52 {
        field := u64(lsb + 1075)
        if field >= 2047 {
            return fromBits(sign | 0x7FF0000000000000)
        }
        return fromBits(sign | field << 52 | mant & 0xFFFFFFFFFFFFF)
    }
    return fromBits(sign | mant)
}

// An optional sign, digits with an optional point among them, and an optional
// exponent: `-12.5e3`, `.5`, `7.`. Nothing else, not even space.
func ParseF64(s string) !f64 {
    mut i u64 = 0
    mut negative := false
    if i < s.len && (s[i] == 45 || s[i] == 43) {
        negative = s[i] == 45
        i += 1
    }
    mut digits := [800]u8{}
    mut n u64 = 0
    mut seen u64 = 0
    mut exp10 i64 = 0
    mut dropped := false
    mut point := false
    for i < s.len {
        c := s[i]
        if c == 46 && !point {
            point = true
        } else if c >= 48 && c <= 57 {
            seen += 1
            if n == 0 && c == 48 {
                // A leading zero says nothing but where the point is.
                if point {
                    exp10 -= 1
                }
            } else if n < keptDigits {
                digits[n] = c - 48
                n += 1
                if point {
                    exp10 -= 1
                }
            } else {
                dropped = dropped || c != 48
                if !point {
                    exp10 += 1
                }
            }
        } else {
            break
        }
        i += 1
    }
    if seen == 0 {
        return error.NotANumber
    }
    if i < s.len && (s[i] == 101 || s[i] == 69) {
        i += 1
        mut minus := false
        if i < s.len && (s[i] == 45 || s[i] == 43) {
            minus = s[i] == 45
            i += 1
        }
        mut e i64 = 0
        mut any := false
        for i < s.len && s[i] >= 48 && s[i] <= 57 {
            // Past this the answer is zero or infinity whatever else is written.
            if e < 100000 {
                e = e * 10 + i64(s[i] - 48)
            }
            any = true
            i += 1
        }
        if !any {
            return error.NotANumber
        }
        if minus {
            e = -e
        }
        exp10 += e
    }
    if i != s.len {
        return error.NotANumber
    }
    mut sign u64 = 0
    if negative {
        sign = 1 << 63
    }
    if n == 0 {
        return fromBits(sign)
    }
    // Wholly out of range: at least 10^309, or below 10^-324.
    if exp10 + i64(n) > 309 {
        return fromBits(sign | 0x7FF0000000000000)
    }
    if exp10 + i64(n) < -324 {
        return fromBits(sign)
    }

    if n <= 15 && !dropped && exp10 >= -22 && exp10 <= 22 {
        mut d u64 = 0
        for k in 0..n {
            d = d * 10 + u64(digits[k])
        }
        mut power := 1.0
        mut steps := exp10
        if steps < 0 {
            steps = -steps
        }
        for k in 0..steps {
            power *= 10.0
        }
        mut v := f64(d)
        if exp10 < 0 {
            v = v / power
        } else {
            v = v * power
        }
        if negative {
            return -v
        }
        return v
    }

    // value = num / den exactly, give or take `dropped`.
    mut num := newBig(0)
    for k in 0..n {
        num.mulAdd(10, u64(digits[k]))
    }
    mut den := newBig(1)
    if exp10 >= 0 {
        for k in 0..exp10 {
            num.mulAdd(10, 0)
        }
    } else {
        for k in 0..-exp10 {
            den.mulAdd(10, 0)
        }
    }
    // Scale so that the quotient has 56 or 57 bits.
    shift := i64(den.bitLen()) - i64(num.bitLen()) + 56
    if shift >= 0 {
        num.shiftLeft(u64(shift))
    } else {
        den.shiftLeft(u64(-shift))
    }
    mut q u64 = 0
    mut b := 58
    for b > 0 {
        b -= 1
        mut step := den
        step.shiftLeft(u64(b))
        if compare(&num, &step) >= 0 {
            num.subtract(&step)
            q |= u64(1) << u64(b)
        }
    }
    return nearest(q, -shift, num.used != 0 || dropped, negative)
}
