package strings

import "std/mem"
import "std/testing"

// Inside the package, so the names are the ones the package declares rather
// than `strings.TrimSpace`.

func TestEqual(mut t *testing.T) !void {
    try t.Equal(Equal("ada", "ada"), true)
    try t.Equal(Equal("ada", "grace"), false)
    try t.Equal(Equal("", ""), true)
    try t.Equal(Equal("a", "ab"), false)
}

func TestTrimSpace(mut t *testing.T) !void {
    try t.Equal(TrimSpace("  ada  "), "ada")
    try t.Equal(TrimSpace("\t\nada\r\n"), "ada")
    try t.Equal(TrimSpace("ada"), "ada")
    try t.Equal(TrimSpace("   "), "")
    try t.Equal(TrimSpace(""), "")
}

func TestPrefixAndIndex(mut t *testing.T) !void {
    try t.Equal(HasPrefix("grace hopper", "grace"), true)
    try t.Equal(HasPrefix("grace", "grace hopper"), false)
    try t.Equal(IndexByte("abc", 98), 1)
    // Not found is the length, which is what keeps the parsing loops readable.
    try t.Equal(IndexByte("abc", 122), 3)
    try t.Equal(Index("hello world", "world"), 6)
    try t.Equal(Index("hello", "xyz"), 5)
    try t.Equal(Index("hello", ""), 0)
    try t.Equal(Contains("hello", "ell"), true)
}

func TestEqualFold(mut t *testing.T) !void {
    try t.Equal(EqualFold("Content-Type", "content-type"), true)
    try t.Equal(EqualFold("ada", "grace"), false)
    try t.Equal(ToLower(65), 97)
    try t.Equal(ToLower(97), 97)
}

func TestParseU64(mut t *testing.T) !void {
    try t.Equal(try ParseU64("0"), 0)
    try t.Equal(try ParseU64("4095"), 4095)
    try t.Equal(try ParseU64("18446744073709551615"), u64(18446744073709551615))

    // One input per subtest, so a failure says which one. The input travels in
    // `t.Arg`, because a subtest body cannot capture anything. The last two do not
    // fit in a u64, and used to stop the program instead of coming back refused.
    bad := [6]string{"", "12a", "-1", " 7", "18446744073709551616", "99999999999999999999"}
    for s in bad {
        try t.RunWith(s, rejects, s)
    }
}

func rejects(mut t *testing.T) !void {
    ParseU64(t.Arg.Text) catch {
        return
    }
    try t.Failf("accepted it")
}

// A table with more than one column per row does not fit in `t.Arg`, so the
// loop stays in the test and names the case itself.
struct trimCase {
    input string
    want  string
}

func TestTrimSpaceTable(mut t *testing.T) !void {
    cases := [4]trimCase{
        trimCase{input: "  ada  ", want: "ada"},
        trimCase{input: "\t\nada\r\n", want: "ada"},
        trimCase{input: "   ", want: ""},
        trimCase{input: "ada", want: "ada"},
    }
    for c in cases {
        got := TrimSpace(c.input)
        if got != c.want {
            try t.Failf("{}: got {} want {}", c.input, got, c.want)
        }
    }
}

func TestConcat(mut t *testing.T) !void {
    mut room := [256]u8{}
    mut arena := mem.NewArena(room[..])
    name := "ada"
    try t.Equal(try Concat(&arena, "hello, ", name, "!"), "hello, ada!")
    try t.Equal(try Concat(&arena, name), "ada")
    try t.Equal(try Concat(&arena), "")
    try t.Equal(try Concat(&arena, "", ""), "")
}

func TestJoin(mut t *testing.T) !void {
    mut room := [256]u8{}
    mut arena := mem.NewArena(room[..])
    fields := [3]string{"a", "bc", ""}
    try t.Equal(try Join(&arena, fields[..], ","), "a,bc,")
    try t.Equal(try Join(&arena, fields[0..1], ", "), "a")
    try t.Equal(try Join(&arena, fields[0..0], ","), "")
}

// Measured once and allocated once: an arena with room for exactly the answer
// is enough, and one byte less is refused rather than written past.
func TestConcatExactSize(mut t *testing.T) !void {
    mut room := [5]u8{}
    mut arena := mem.NewArena(room[..])
    try t.Equal(try Concat(&arena, "ab", "cde"), "abcde")
    Concat(&arena, "x") catch {
        return
    }
    try t.Failf("allocated past the arena")
}

// --- C strings -------------------------------------------------------------

func TestFromC(mut t *testing.T) !void {
    text := [6]u8{104, 101, 108, 108, 111, 0}  // "hello" and its end
    try t.Equal(FromC(text[..].ptr), "hello")
    nothing := [1]u8{0}
    try t.Equal(FromC(nothing[..].ptr), "")
}

// A char[N] that the text fills has no zero; the limit is what stops the read.
func TestFromCMax(mut t *testing.T) !void {
    full := [4]u8{65, 66, 67, 68}
    try t.Equal(FromCMax(full[..].ptr, 4), "ABCD")
    short := [4]u8{65, 0, 67, 68}
    try t.Equal(FromCMax(short[..].ptr, 4), "A")
    try t.Equal(FromCMax(full[..].ptr, 0), "")
}

func TestToC(mut t *testing.T) !void {
    mut room := [6]u8{}
    p := try ToC("hello", room[..])
    try t.Equal(room[5], u8(0))
    try t.Equal(FromC(p), "hello")

    // Exactly the length plus its zero fits; one less does not.
    mut tight := [5]u8{}
    mut refused := false
    ToC("hello", tight[..]) catch {
        refused = true
    }
    try t.Equal(refused, true)

    mut inner := false
    ToC("a.txt\0../secret", room[..]) catch {
        inner = true
    }
    try t.Equal(inner, true)
}
