// expect: 42
// expect-output: files served
// Serving a file is streamed against a length the operating system already knows,
// so a large download costs one buffer. And the part that matters more than
// speed: a path that tries to climb out of the root is refused, not resolved.
// A file goes out with its ETag and Last-Modified, and a cache that already has
// that version is answered 304 without the body.

import "std/fs"
import "std/http"
import "std/io"
import "std/mem"
import "std/net"
import "std/strings"

func serve(s *http.Server, m *http.Mux) !void {
    try s.ServeWith(m, 32)
}

// Sends one request and returns everything that came back.
func ask(port i32, request string, mut into []u8) !u64 {
    mut c := try net.Dial("127.0.0.1", port)
    try c.WriteString(request)
    mut have u64 = 0
    for {
        n := c.Read(into[have..into.len]) catch 0
        if n == 0 {
            break
        }
        have += n
    }
    c.Close()
    return have
}

func drive(port i32, mut score *atomic[u64], s *http.Server) !void {
    mut room := [8192]u8{}
    // Kept apart: the validators in this answer are asked with further down,
    // after `room` has held several other replies.
    mut first := [1024]u8{}

    n := ask(port, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
             first[..]) catch 0
    reply := string(first[0..n])
    if strings.Contains(reply, "200 OK") &&
       strings.Contains(reply, "Content-Length: 11") &&
       strings.Contains(reply, "text/plain") &&
       strings.Contains(reply, "hello world") {
        score.Add(1)
    }

    // The index, for a path that names the directory.
    m := ask(port, "GET /files/ HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
             room[..]) catch 0
    index := string(room[0..m])
    if strings.Contains(index, "200 OK") &&
       strings.Contains(index, "text/html") &&
       strings.Contains(index, "<h1>index</h1>") {
        score.Add(2)
    }

    // Out of the root: refused on sight.
    b := ask(port, "GET /files/../../etc/passwd HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
             room[..]) catch 0
    climb := string(room[0..b])
    if strings.Contains(climb, "400") && !strings.Contains(climb, "root:") {
        score.Add(4)
    }

    // Nothing there.
    g := ask(port, "GET /files/nope.txt HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
             room[..]) catch 0
    if strings.Contains(string(room[0..g]), "404") {
        score.Add(8)
    }

    // HEAD: the head of the answer and none of the body.
    h := ask(port, "HEAD /files/hello.txt HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
             room[..]) catch 0
    head := string(room[0..h])
    if strings.Contains(head, "Content-Length: 11") &&
       !strings.Contains(head, "hello world") {
        score.Add(16)
    }

    // A file larger than one read: the pieces have to arrive in order and all of
    // them, which a length in the head makes checkable.
    big := ask(port, "GET /files/big.bin HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
               room[..]) catch 0
    whole := string(room[0..big])
    if strings.Contains(whole, "Content-Length: 5000") &&
       strings.Contains(whole, "application/octet-stream") &&
       big >= 5000 {
        score.Add(32)
    }

    // The validators the first answer carried, and the ways of asking with them.
    tagAt := strings.Index(reply, "ETag: ")
    if tagAt < reply.len && strings.Contains(reply, "Last-Modified: ") {
        rest := reply[tagAt + 6..reply.len]
        tag := rest[0..strings.Index(rest, "\r\n")]
        if strings.HasPrefix(tag, "W/\"") {
            score.Add(64)
        }
        mut backing := [512]u8{}
        mut arena := mem.NewArena(backing[..])
        q1 := try strings.Concat(&arena, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"x\", ",
                                 tag, "\r\nConnection: close\r\n\r\n")
        k := ask(port, q1, room[..]) catch 0
        same := string(room[0..k])
        if strings.Contains(same, "304") && strings.Contains(same, tag) &&
           !strings.Contains(same, "hello world") {
            score.Add(128)
        }
    }
    star := ask(port, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nIf-None-Match: *\r\nConnection: close\r\n\r\n",
                room[..]) catch 0
    if strings.Contains(string(room[0..star]), "304") {
        score.Add(256)
    }
    later := ask(port, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nIf-Modified-Since: Fri, 31 Dec 9999 23:59:59 GMT\r\nConnection: close\r\n\r\n",
                 room[..]) catch 0
    if strings.Contains(string(room[0..later]), "304") {
        score.Add(512)
    }
    earlier := ask(port, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nIf-Modified-Since: Thu, 01 Jan 1970 00:00:00 GMT\r\nConnection: close\r\n\r\n",
                   room[..]) catch 0
    if strings.Contains(string(room[0..earlier]), "hello world") {
        score.Add(1024)
    }
    // A tag that does not match decides on its own: the date beside it is not
    // even read, however far in the future it is.
    other := ask(port, "GET /files/hello.txt HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"other\"\r\nIf-Modified-Since: Fri, 31 Dec 9999 23:59:59 GMT\r\nConnection: close\r\n\r\n",
                 room[..]) catch 0
    if strings.Contains(string(room[0..other]), "hello world") {
        score.Add(2048)
    }

    s.Close()
}

func main() !int {
    // One directory, three files in it. The directory's name is this run's
    // own: TempPath makes a file under it, and the directory takes its place.
    mut room := [256]u8{}
    mut backing := [1024]u8{}
    mut arena := mem.NewArena(backing[..])
    root := try fs.TempPath("/tmp/sword_static.", room[..])
    try fs.Remove(root)
    try fs.MakeDir(root)
    hello := try strings.Concat(&arena, root, "/hello.txt")
    index := try strings.Concat(&arena, root, "/index.html")
    blob := try strings.Concat(&arena, root, "/big.bin")
    try fs.WriteAll(hello, []u8("hello world"))
    try fs.WriteAll(index, []u8("<h1>index</h1>\n"))

    mut big := [5000]u8{}
    for i in 0..5000 {
        big[i] = u8(48 + i % 10)
    }
    try fs.WriteAll(blob, big[..])

    mut files := http.NewFiles(root)

    mut mux := http.NewMux()
    try mux.Get("/files/{path...}", &files)
    try mux.Handle("HEAD", "/files/{path...}", &files)

    mut srv := try http.Listen(0)
    port := srv.Port()

    mut score := atomic[u64](0)
    scope {
        spawn serve(&srv, &mux)
        spawn drive(port, &score, &srv)
    }

    fs.Remove(hello) catch {}
    fs.Remove(index) catch {}
    fs.Remove(blob) catch {}
    fs.RemoveDir(root) catch {}

    if score.Load() != 4095 {
        try io.Printf("score {}\n", score.Load())
        return 1
    }
    try io.Print("files served\n")
    return 42
}
