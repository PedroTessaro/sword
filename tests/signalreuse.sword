// expect: 42
// expect-output: caught on a reused number
// A closed socket's number is often the next one handed out, and here the signal
// pipe gets the listener's. A wait carries the generation of the descriptor it
// read before the call that said "not yet", and the pipe's is its own, so the
// signal is waited for rather than refused.

import "std/io"
import "std/net"
import "std/os"
import "std/time"

func listener(mut got *atomic[u64]) !void {
    sig := try os.WaitSignal()
    got.Store(u64(i32(sig)))
}

func sender() !void {
    time.Sleep(time.Millis(30))
    try os.Kill(os.Pid(), os.Signal.Terminate)
}

func main() !int {
    l := try net.Listen(0)
    l.Close()

    try os.Catch(os.Signal.Terminate)
    mut got := atomic[u64](0)
    scope {
        spawn listener(&got)
        spawn sender()
    }
    if got.Load() != 15 {
        try io.Printf("got {}\n", got.Load())
        return 1
    }
    try io.Print("caught on a reused number\n")
    return 42
}
