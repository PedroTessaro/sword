// expect-error: 'hashof' takes an integer, an enum, a bool or a string
// A hash is only worth anything beside an equality that agrees with it, and
// two structs of the same bytes are not the same value here.

struct Point {
    x i64
    y i64
}

func main() int {
    p := Point{x: 1, y: 2}
    return int(hashof(p))
}
