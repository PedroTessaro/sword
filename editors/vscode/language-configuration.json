{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^(\"(\\\\.|[^\"\\\\])*\"|(?!//)[^\"])*(\\{[^}\"]*|\\([^)\"]*|\\[[^\\]\"]*)(\\s*//.*)?$|^\\s*(case\\b.*|default)\\s*:\\s*$",
    "decreaseIndentPattern": "^\\s*[)\\]}]|^\\s*(case\\b.*|default)\\s*:\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*(?!.*\\*/)",
      "afterText": "^\\s*\\*/",
      "action": { "indent": "indentOutdent", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*/\\*(?!.*\\*/)",
      "action": { "indent": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s+\\*( ([^*]|\\*(?!/))*)?$",
      "previousLineText": "^\\s*(/\\*|\\*)(?!.*\\*/)",
      "action": { "indent": "none", "appendText": "* " }
    },
    {
      "beforeText": "^\\s+\\*/\\s*$",
      "action": { "indent": "none", "removeText": 1 }
    }
  ]
}
